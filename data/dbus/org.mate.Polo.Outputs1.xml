  org.mate.Polo.Outputs1 on /org/mate/Polo: the monitor layout for a MATE
  display tool, in MateRR's terms.

  An output is an a{sv} with
    name s, display-name s, vendor s, product s, serial s, internal b,
    physical-width i, physical-height i (mm), modes a(iiib) (width, height,
    refresh in mHz, preferred), enabled b, primary b, x i, y i, width i,
    height i, refresh i, scale i, transform u (wl_output.transform).
-->
<node>
  <interface name="org.mate.Polo.Outputs1">
    <!-- Every connected output. -->
    <method name="GetOutputs">
      <arg name="outputs" type="aa{sv}" direction="out"/>
    </method>
    <!--
      serial: the Serial the caller's outputs came from; another one fails with
      org.mate.Polo.Outputs1.Error.Stale. outputs: each an a{sv} with name and
      any of enabled, primary, x, y, width, height, refresh, scale, transform;
      outputs left out keep their state. persistent: ask "Does the display look
      OK?" and save the layout if kept, reverting after 30 seconds otherwise, as
      mate-settings-daemon's xrandr plugin does; false applies it until the
      next login or hotplug. Other errors: .Invalid, .Failed and .Busy (a
      confirmation is still open).
    -->
    <method name="ApplyConfiguration">
      <arg name="serial" type="u" direction="in"/>
      <arg name="outputs" type="aa{sv}" direction="in"/>
      <arg name="persistent" type="b" direction="in"/>
    </method>
    <!-- After every layout change, with the new Serial. -->
    <signal name="Changed">
      <arg name="serial" type="u"/>
    </signal>
    <property name="Serial" type="u" access="read"/>
  </interface>
</node>
