+static void
+drm_output_set_gamma(struct weston_output *output_base, uint32_t size,
+		     const uint16_t *r, const uint16_t *g, const uint16_t *b)
+{
+	struct drm_output *output = to_drm_output(output_base);
+	struct drm_device *device = output->device;
+	int fd = device->kms_device->fd;
+
+	if (!output->crtc || size != output_base->gamma_size)
+		return;
+
+	if (device->atomic_modeset) {
+		struct drm_color_lut *lut = NULL;
+		uint32_t blob_id = 0;
+
+		if (r) {
+			lut = calloc(size, sizeof *lut);
+			if (!lut)
+				return;
+			for (uint32_t i = 0; i < size; i++) {
+				lut[i].red = r[i];
+				lut[i].green = g[i];
+				lut[i].blue = b[i];
+			}
+			if (drmModeCreatePropertyBlob(fd, lut, size * sizeof *lut,
+						      &blob_id) != 0)
+				blob_id = 0;
+			free(lut);
+		}
+		if (output->gamma_blob_id)
+			drmModeDestroyPropertyBlob(fd, output->gamma_blob_id);
+		output->gamma_blob_id = blob_id;
+		weston_output_damage(output_base);
+		weston_output_schedule_repaint(output_base);
+		return;
+	}
+
+	free(output->legacy_gamma);
+	output->legacy_gamma = NULL;
+	if (r) {
+		output->legacy_gamma = calloc(3 * size, sizeof(uint16_t));
+		if (!output->legacy_gamma)
+			return;
+		memcpy(output->legacy_gamma, r, size * sizeof(uint16_t));
+		memcpy(output->legacy_gamma + size, g, size * sizeof(uint16_t));
+		memcpy(output->legacy_gamma + 2 * size, b,
+		       size * sizeof(uint16_t));
+	}
+	drm_output_reset_legacy_gamma(output);
+}
+
+/* GAMMA_LUT when atomic, unless the colour pipeline owns it; else legacy. */
+static void
+drm_output_init_client_gamma(struct drm_output *output)
+{
+	struct drm_device *device = output->device;
+
+	output->base.gamma_size = 0;
+	output->base.set_gamma = NULL;
+	if (output->base.from_blend_to_output_by_backend)
+		return;
+	if (device->atomic_modeset)
+		output->base.gamma_size = output->crtc->lut_size;
+	else if (!output->legacy_gamma_not_supported)
+		output->base.gamma_size = output->legacy_gamma_size;
+	if (output->base.gamma_size > 0)
+		output->base.set_gamma = drm_output_set_gamma;
+}
