+	if (weston_output_zoom_active(output)) {
+		struct weston_matrix zoom;
+		double scale = output->zoom.scale;
+		double width = output->width / scale;
+		double height = output->height / scale;
+		double left = output->pos.c.x;
+		double top = output->pos.c.y;
+		double x, y;
+
+		x = output->zoom.center.c.x - width / 2;
+		y = output->zoom.center.c.y - height / 2;
+		x = fmin(fmax(x, left), left + output->width - width);
+		y = fmin(fmax(y, top), top + output->height - height);
+
+		weston_matrix_init(&zoom);
+		weston_matrix_translate(&zoom, -x, -y, 0);
+		weston_matrix_scale(&zoom, scale, scale, 1);
+		weston_matrix_translate(&zoom, left, top, 0);
+		weston_matrix_multiply(&zoom, &output->matrix);
+		output->matrix = zoom;
+	}
+
 	weston_matrix_invert(&output->inverse_matrix, &output->matrix);
 }
 
+/** Whether the output is magnified
+ *
+ * \param output The output.
+ * \return True while its zoom scale is above 1.
+ *
+ * \ingroup output
+ */
+WL_EXPORT bool
+weston_output_zoom_active(const struct weston_output *output)
+{
+	return output->zoom.scale > 1;
+}
+
+/** Magnify an output
+ *
+ * \param output The output.
+ * \param scale The magnification, clamped to 1–32; 1 turns zoom off.
+ * \param center The global point to centre on. The shown area is kept
+ * inside the output, so near its edges the point is off-centre.
+ *
+ * The output's matrices change, so rendering, damage and absolute input
+ * (touch, tablets) all follow; the output is damaged as a whole.
+ *
+ * \ingroup output
+ */
+WL_EXPORT void
+weston_output_set_zoom(struct weston_output *output, double scale,
+		       struct weston_coord_global center)
+{
+	if (!(scale >= 1))
+		scale = 1;
+	if (scale > 32)
+		scale = 32;
+	if (!isfinite(center.c.x) || !isfinite(center.c.y))
+		center = output->zoom.center;
+
+	if (scale == output->zoom.scale &&
+	    (scale == 1 || (center.c.x == output->zoom.center.c.x &&
+			    center.c.y == output->zoom.center.c.y)))
+		return;
+
+	output->zoom.scale = scale;
+	output->zoom.center = center;
+	if (!output->enabled)
+		return;
+	weston_output_update_matrix(output);
+	weston_output_damage(output);
+}
