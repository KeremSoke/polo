+static void
+handle_gesture(struct evdev_device *device, struct libinput_event *event)
+{
+	struct weston_pointer *pointer = weston_seat_get_pointer(device->seat);
+	struct libinput_event_gesture *gesture =
+		libinput_event_get_gesture_event(event);
+	struct weston_pointer_gesture_event ev = { 0 };
+
+	if (!pointer)
+		return;
+	switch (libinput_event_get_type(event)) {
+	case LIBINPUT_EVENT_GESTURE_SWIPE_BEGIN:
+		ev.kind = WESTON_POINTER_GESTURE_SWIPE;
+		ev.phase = WESTON_POINTER_GESTURE_BEGIN;
+		break;
+	case LIBINPUT_EVENT_GESTURE_SWIPE_UPDATE:
+		ev.kind = WESTON_POINTER_GESTURE_SWIPE;
+		ev.phase = WESTON_POINTER_GESTURE_UPDATE;
+		break;
+	case LIBINPUT_EVENT_GESTURE_SWIPE_END:
+		ev.kind = WESTON_POINTER_GESTURE_SWIPE;
+		ev.phase = WESTON_POINTER_GESTURE_END;
+		break;
+	case LIBINPUT_EVENT_GESTURE_PINCH_BEGIN:
+		ev.kind = WESTON_POINTER_GESTURE_PINCH;
+		ev.phase = WESTON_POINTER_GESTURE_BEGIN;
+		break;
+	case LIBINPUT_EVENT_GESTURE_PINCH_UPDATE:
+		ev.kind = WESTON_POINTER_GESTURE_PINCH;
+		ev.phase = WESTON_POINTER_GESTURE_UPDATE;
+		break;
+	case LIBINPUT_EVENT_GESTURE_PINCH_END:
+		ev.kind = WESTON_POINTER_GESTURE_PINCH;
+		ev.phase = WESTON_POINTER_GESTURE_END;
+		break;
+	case LIBINPUT_EVENT_GESTURE_HOLD_BEGIN:
+		ev.kind = WESTON_POINTER_GESTURE_HOLD;
+		ev.phase = WESTON_POINTER_GESTURE_BEGIN;
+		break;
+	default:
+		ev.kind = WESTON_POINTER_GESTURE_HOLD;
+		ev.phase = WESTON_POINTER_GESTURE_END;
+		break;
+	}
+	ev.time_msec = libinput_event_gesture_get_time(gesture);
+	ev.fingers = libinput_event_gesture_get_finger_count(gesture);
+	ev.scale = 1.0;
+	if (ev.phase == WESTON_POINTER_GESTURE_UPDATE) {
+		ev.dx = libinput_event_gesture_get_dx(gesture);
+		ev.dy = libinput_event_gesture_get_dy(gesture);
+		if (ev.kind == WESTON_POINTER_GESTURE_PINCH) {
+			ev.scale = libinput_event_gesture_get_scale(gesture);
+			ev.rotation =
+				libinput_event_gesture_get_angle_delta(gesture);
+		}
+	}
+	if (ev.phase == WESTON_POINTER_GESTURE_END)
+		ev.cancelled = libinput_event_gesture_get_cancelled(gesture);
+	wl_signal_emit(&pointer->gesture_signal, &ev);
+}
