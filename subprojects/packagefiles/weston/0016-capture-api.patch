+/** A framebuffer capture source for a compositor component
+ *
+ * Like weston_capture_source_v1 with the framebuffer pixel source, but
+ * reporting through @callbacks. Authorizing the capture is the caller's.
+ */
+WL_EXPORT struct weston_capture_source *
+weston_output_capture_source_create(struct weston_output *output,
+				    const struct weston_capture_callbacks *callbacks,
+				    void *data)
+{
+	struct weston_capture_source *csrc = xzalloc(sizeof *csrc);
+
+	csrc->pixel_source = WESTON_OUTPUT_CAPTURE_SOURCE_FRAMEBUFFER;
+	csrc->callbacks = callbacks;
+	csrc->data = data;
+	csrc->output = output;
+	wl_list_insert(&output->capture_info->capture_source_list, &csrc->link);
+	return csrc;
+}
+
+WL_EXPORT void
+weston_capture_source_destroy(struct weston_capture_source *csrc)
+{
+	if (csrc->pending)
+		weston_capture_task_destroy(csrc->pending);
+	wl_list_remove(&csrc->link);
+	free(csrc);
+}
+
+/** Queue a capture into @buffer on the output's next repaint
+ *
+ * Scheduling that repaint is the caller's.
+ */
+WL_EXPORT enum weston_capture_result
+weston_capture_source_capture(struct weston_capture_source *csrc,
+			      struct weston_buffer *buffer)
+{
+	struct weston_output_capture_source_info *csi;
+
+	if (csrc->pending)
+		return WESTON_CAPTURE_BUSY;
+	if (!csrc->output)
+		return WESTON_CAPTURE_UNAVAILABLE;
+	csi = capture_info_get_csi(csrc->output->capture_info,
+				   csrc->pixel_source);
+	if (!source_info_is_available(csi))
+		return WESTON_CAPTURE_UNAVAILABLE;
+	if (!buffer_is_compatible(buffer, csi))
+		return WESTON_CAPTURE_INCOMPATIBLE;
+	csrc->pending = weston_capture_task_create(csrc, buffer);
+	return WESTON_CAPTURE_QUEUED;
+}
+
+/** The framebuffer capture's buffer size and DRM format, if available */
+WL_EXPORT bool
+weston_output_get_capture_info(struct weston_output *output, int *width,
+			       int *height, uint32_t *drm_format)
+{
+	struct weston_output_capture_source_info *csi;
+
+	if (!output->capture_info)
+		return false;
+	csi = capture_info_get_csi(output->capture_info,
+				   WESTON_OUTPUT_CAPTURE_SOURCE_FRAMEBUFFER);
+	if (!source_info_is_available(csi))
+		return false;
+	*width = csi->width;
+	*height = csi->height;
+	*drm_format = csi->drm_format;
+	return true;
+}
