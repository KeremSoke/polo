-					       toplevel->next.size.height);
-		return;
-	}
+	if (!toplevel->size_mismatch_logged &&
+	    ((toplevel->next.state.maximized &&
+	      (toplevel->next.size.width != geometry.width ||
+	       toplevel->next.size.height != geometry.height)) ||
+	     (toplevel->next.state.fullscreen &&
+	      (toplevel->next.size.width < geometry.width ||
