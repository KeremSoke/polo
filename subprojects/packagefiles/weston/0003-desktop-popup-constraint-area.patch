From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Polo <polo@invalid>
Date: Sun, 25 Oct 2026 00:02:28 -0700
Subject: [PATCH] desktop: popup constraint area hook and spec-conformant
 flips

Shells cannot choose the area popups are constrained to: libweston always
uses the whole output, so a menu of a window near a panel can end up under
the panel. Add an optional weston_desktop_api.get_popup_constraint_area
callback, called with the output's geometry for the shell to shrink (for
example to the work area, as GTK3 does on X11).

Also follow xdg_positioner for flips: if the flipped position is constrained
as well, keep the position from before the flip. libweston flipped
unconditionally.

Polo patch G7.
---
 include/libweston/desktop.h           |  4 +++
 libweston/desktop/internal.h          |  6 ++++
 libweston/desktop/libweston-desktop.c | 17 +++++++++++
 libweston/desktop/xdg-shell.c         | 43 ++++++++++++++++-----------
 4 files changed, 52 insertions(+), 18 deletions(-)

diff --git a/include/libweston/desktop.h b/include/libweston/desktop.h
index b9f590f..a86df6f 100644
--- a/include/libweston/desktop.h
+++ b/include/libweston/desktop.h
@@ -125,6 +125,10 @@ struct weston_desktop_api {
 	void (*get_position)(struct weston_desktop_surface *surface,
 			     int32_t *x, int32_t *y,
 			     void *user_data);
+	void (*get_popup_constraint_area)(struct weston_desktop_surface *popup,
+					  struct weston_output *output,
+					  struct weston_geometry *area,
+					  void *user_data);
 };
 
 void
diff --git a/libweston/desktop/internal.h b/libweston/desktop/internal.h
index 1170021..42e42b4 100644
--- a/libweston/desktop/internal.h
+++ b/libweston/desktop/internal.h
@@ -91,6 +91,12 @@ weston_desktop_api_get_position(struct weston_desktop *desktop,
 				struct weston_desktop_surface *surface,
 				int32_t *x, int32_t *y);
 
+void
+weston_desktop_api_get_popup_constraint_area(struct weston_desktop *desktop,
+					     struct weston_desktop_surface *popup,
+					     struct weston_output *output,
+					     struct weston_geometry *area);
+
 struct weston_desktop_seat *
 weston_desktop_seat_from_seat(struct weston_seat *wseat);
 
diff --git a/libweston/desktop/libweston-desktop.c b/libweston/desktop/libweston-desktop.c
index c1d82e6..3df9bb6 100644
--- a/libweston/desktop/libweston-desktop.c
+++ b/libweston/desktop/libweston-desktop.c
@@ -284,3 +284,20 @@ weston_desktop_api_get_position(struct weston_desktop *desktop,
 
 	desktop->api.get_position(surface, x, y, desktop->user_data);
 }
+
+void
+weston_desktop_api_get_popup_constraint_area(struct weston_desktop *desktop,
+					     struct weston_desktop_surface *popup,
+					     struct weston_output *output,
+					     struct weston_geometry *area)
+{
+	*area = (struct weston_geometry) {
+		.x = output->pos.c.x,
+		.y = output->pos.c.y,
+		.width = output->width,
+		.height = output->height,
+	};
+	if (desktop->api.get_popup_constraint_area)
+		desktop->api.get_popup_constraint_area(popup, output, area,
+						       desktop->user_data);
+}
