+static enum test_result_code
+deform_and_clear(struct wet_testsuite_data *suite_data)
+{
+	const struct setup_args *args = &my_setup_args[get_test_fixture_index()];
+	bool supported = args->renderer == WESTON_RENDERER_GL;
+	struct client *client;
+
+	client = create_halves_client();
+	test_assert_ptr_not_null(client);
+	weston_test_move_pointer(client->test->weston_test, 0, 1, 0, 300, 230);
+
+	test_assert_u32_eq(pixel_at(client, ORIGIN_X + 8, ORIGIN_Y + 32), red);
+
+	client_push_breakpoint(client, suite_data,
+			       WESTON_TEST_BREAKPOINT_POST_REPAINT,
+			       (struct wl_proxy *) client->output->wl_output);
+	move_client(client, ORIGIN_X, ORIGIN_Y);
+	RUN_INSIDE_BREAKPOINT(client, suite_data) {
+		struct weston_view_deform_vertex grid[9];
+		struct weston_view *view = find_view(breakpoint->compositor);
+		pixman_box32_t *box;
+		int ret;
+
+		test_assert_ptr_not_null(view);
+		test_assert_int_eq(weston_view_set_deformation(view, NULL, 3, 3),
+				   supported ? -EINVAL : -ENOTSUP);
+		mirror_grid(grid);
+		ret = weston_view_set_deformation(view, grid, 3, 3);
+		if (!supported) {
+			test_assert_int_eq(ret, -ENOTSUP);
+			test_assert_ptr_null(view->deformation.grid);
+			continue;
+		}
+		test_assert_int_eq(ret, 0);
+		test_assert_int_eq(weston_view_set_deformation(view, grid, 1, 9),
+				   -EINVAL);
+
+		weston_view_update_transform(view);
+		box = pixman_region32_extents(&view->transform.boundingbox);
+		test_assert_int_eq(box->x1, GRID_X);
+		test_assert_int_eq(box->y1, GRID_Y);
+		test_assert_int_eq(box->x2, GRID_X + SIZE);
+		test_assert_int_eq(box->y2, GRID_Y + SIZE);
+		test_assert_false(pixman_region32_not_empty(&view->transform.opaque));
+		test_assert_false(weston_view_is_opaque(view, &view->transform.boundingbox));
+	}
+
+	if (!supported) {
+		test_assert_u32_eq(pixel_at(client, ORIGIN_X + 8, ORIGIN_Y + 32),
+				   red);
+		client_destroy(client);
+		return RESULT_OK;
+	}
+
+	/* Mirrored, in each row of the grid, and gone from where it was. */
+	test_assert_u32_eq(pixel_at(client, GRID_X + 8, GRID_Y + 8), blue);
+	test_assert_u32_eq(pixel_at(client, GRID_X + 8, GRID_Y + 56), blue);
+	test_assert_u32_eq(pixel_at(client, GRID_X + 56, GRID_Y + 8), red);
+	test_assert_u32_eq(pixel_at(client, GRID_X + 56, GRID_Y + 56), red);
+	test_assert_u32_ne(pixel_at(client, ORIGIN_X + 8, ORIGIN_Y + 32), red);
+
+	client_push_breakpoint(client, suite_data,
+			       WESTON_TEST_BREAKPOINT_POST_REPAINT,
+			       (struct wl_proxy *) client->output->wl_output);
+	move_client(client, ORIGIN_X, ORIGIN_Y);
+	RUN_INSIDE_BREAKPOINT(client, suite_data) {
+		struct weston_view *view = find_view(breakpoint->compositor);
+
+		test_assert_ptr_not_null(view);
+		weston_view_clear_deformation(view);
+		test_assert_ptr_null(view->deformation.grid);
+	}
+
+	test_assert_u32_eq(pixel_at(client, ORIGIN_X + 8, ORIGIN_Y + 32), red);
+	test_assert_u32_eq(pixel_at(client, ORIGIN_X + 56, ORIGIN_Y + 32), blue);
+	test_assert_u32_ne(pixel_at(client, GRID_X + 8, GRID_Y + 8), blue);
+
+	client_destroy(client);
+	return RESULT_OK;
+}
