+#define SIZE 64
+#define ORIGIN_X 10
+#define ORIGIN_Y 10
+#define GRID_X 100
+#define GRID_Y 50
+
+static const uint32_t red = 0xffff0000;
+static const uint32_t blue = 0xff0000ff;
+
+/* A SIZE x SIZE surface, red on the left half and blue on the right. */
+static struct client *
+create_halves_client(void)
+{
+	struct client *client = create_client();
+	struct surface *surface = create_test_surface(client);
+	pixman_color_t left, right;
+	pixman_rectangle16_t half = { 0, 0, SIZE / 2, SIZE };
+	pixman_image_t *solid;
+
+	client->surface = surface;
+	surface->width = SIZE;
+	surface->height = SIZE;
+	surface->buffer = create_shm_buffer_a8r8g8b8(client, SIZE, SIZE);
+
+	color_rgb888(&left, 255, 0, 0);
+	pixman_image_fill_rectangles(PIXMAN_OP_SRC, surface->buffer->image,
+				     &left, 1, &half);
+	half.x = SIZE / 2;
+	color_rgb888(&right, 0, 0, 255);
+	solid = surface->buffer->image;
+	pixman_image_fill_rectangles(PIXMAN_OP_SRC, solid, &right, 1, &half);
+
+	move_client_frame_sync(client, ORIGIN_X, ORIGIN_Y);
+
+	return client;
+}
+
+static struct weston_view *
+find_view(struct weston_compositor *compositor)
+{
+	struct weston_view *view;
+
+	wl_list_for_each(view, &compositor->view_list, link) {
+		if (view->surface->width == SIZE &&
+		    view->surface->height == SIZE)
+			return view;
+	}
+	return NULL;
+}
+
+static uint32_t
+pixel_at(struct client *client, int x, int y)
+{
+	struct buffer *shot = capture_screenshot_of_output(client, NULL,
+							   NO_DECORATIONS);
+	struct image_header ih = image_header_from(shot->image);
+	uint32_t pixel = image_header_get_row_u32(&ih, y)[x];
+
+	buffer_destroy(shot);
+	return pixel;
+}
+
+/* The surface mirrored left to right onto SIZE x SIZE at GRID_X, GRID_Y,
+ * through a 3 x 3 grid so the rows of triangle strips join. */
+static void
+mirror_grid(struct weston_view_deform_vertex grid[9])
+{
+	int r, c;
+
+	for (r = 0; r < 3; r++) {
+		for (c = 0; c < 3; c++) {
+			grid[r * 3 + c] = (struct weston_view_deform_vertex) {
+				.x = GRID_X + c * SIZE / 2,
+				.y = GRID_Y + r * SIZE / 2,
+				.u = 1.0f - c / 2.0f,
+				.v = r / 2.0f,
+			};
+		}
+	}
+}
