+/* A deformed view covers its grid's bounding box and occludes nothing. */
+static void
+view_deformation_bbox(struct weston_view *view)
+{
+	const struct weston_view_deform_vertex *grid = view->deformation.grid;
+	uint32_t n = view->deformation.cols * view->deformation.rows;
+	float min_x = HUGE_VALF, min_y = HUGE_VALF;
+	float max_x = -HUGE_VALF, max_y = -HUGE_VALF;
+	uint32_t i;
+
+	for (i = 0; i < n; i++) {
+		min_x = MIN(min_x, grid[i].x);
+		min_y = MIN(min_y, grid[i].y);
+		max_x = MAX(max_x, grid[i].x);
+		max_y = MAX(max_y, grid[i].y);
+	}
+
+	pixman_region32_fini(&view->transform.boundingbox);
+	pixman_region32_init_rect(&view->transform.boundingbox,
+				  floorf(min_x), floorf(min_y),
+				  ceilf(max_x) - floorf(min_x),
+				  ceilf(max_y) - floorf(min_y));
+	pixman_region32_clear(&view->transform.opaque);
+}
