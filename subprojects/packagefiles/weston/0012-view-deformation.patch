+/** Draw a view through a mesh
+ *
+ * \param view The view to deform.
+ * \param grid cols x rows vertices, row-major: global logical positions with
+ * normalised surface coordinates. It is copied.
+ * \param cols Vertices per row, at least 2.
+ * \param rows Rows of vertices, at least 2.
+ * \return 0 on success, -EINVAL for a bad grid, or -ENOTSUP when the
+ * renderer cannot deform views; the view is then drawn undeformed.
+ *
+ * The renderer draws the grid as triangles, texturing them from the
+ * surface. The view's bounding box becomes the grid's, it occludes nothing
+ * below it, and it never goes on a hardware plane. Input still uses the
+ * undeformed view.
+ */
+WL_EXPORT int
+weston_view_set_deformation(struct weston_view *view,
+			    const struct weston_view_deform_vertex *grid,
+			    uint32_t cols, uint32_t rows)
+{
+	struct weston_view_deform_vertex *copy;
+	size_t n;
+	size_t i;
+
+	if (!weston_compositor_supports_view_deformation(view->surface->compositor))
+		return -ENOTSUP;
+	if (!grid || cols < 2 || rows < 2 || (size_t)cols * rows > UINT16_MAX)
+		return -EINVAL;
+
+	n = (size_t)cols * rows;
+	for (i = 0; i < n; i++) {
+		if (!isfinite(grid[i].x) || !isfinite(grid[i].y) ||
+		    !isfinite(grid[i].u) || !isfinite(grid[i].v))
+			return -EINVAL;
+	}
+
+	if (view->deformation.grid &&
+	    view->deformation.cols * view->deformation.rows == n) {
+		copy = view->deformation.grid;
+	} else {
+		copy = malloc(n * sizeof *copy);
+		if (!copy)
+			return -ENOMEM;
+		free(view->deformation.grid);
+	}
+	memcpy(copy, grid, n * sizeof *copy);
+	view->deformation.grid = copy;
+	view->deformation.cols = cols;
+	view->deformation.rows = rows;
+	weston_view_geometry_dirty(view);
+
+	return 0;
+}
+
+/** Whether weston_view_set_deformation() can succeed
+ *
+ * \param compositor The compositor.
+ * \return True when the renderer draws deformed views.
+ */
+WL_EXPORT bool
+weston_compositor_supports_view_deformation(struct weston_compositor *compositor)
+{
+	return compositor->renderer &&
+	       compositor->renderer->type == WESTON_RENDERER_GL;
+}
+
+/** Draw a view undeformed again
+ *
+ * \param view The view.
+ */
+WL_EXPORT void
+weston_view_clear_deformation(struct weston_view *view)
+{
+	if (!view->deformation.grid)
+		return;
+
+	free(view->deformation.grid);
+	view->deformation.grid = NULL;
+	view->deformation.cols = 0;
+	view->deformation.rows = 0;
+	weston_view_geometry_dirty(view);
+}
