+/* A view deformed by weston_view_set_deformation (): the whole grid as
+ * triangle strips joined by degenerate triangles, cut to the repaint region
+ * with the scissor. */
+static void
+draw_deformed(struct gl_renderer *gr,
+	      struct weston_paint_node *pnode,
+	      struct gl_shader_config *sconf,
+	      pixman_region32_t *repaint)
+{
+	struct gl_surface_state *gs = get_surface_state(pnode->surface);
+	struct gl_output_state *go = get_output_state(pnode->output);
+	struct gl_buffer_state *gb = gs->buffer;
+	const struct weston_view *view = pnode->view;
+	const struct weston_view_deform_vertex *grid = view->deformation.grid;
+	const uint32_t cols = view->deformation.cols;
+	const uint32_t rows = view->deformation.rows;
+	const uint32_t n = cols * rows;
+	const int nidx = (rows - 1) * cols * 2 + (rows - 2) * 2;
+	const uint32_t bx = 0xff0000, by = 0x00ff00, bz = 0x0000ff;
+	const uint32_t corners[3] = { bx, by, bz };
+	bool wireframe = gr->debug_mode == DEBUG_MODE_WIREFRAME;
+	struct clipper_vertex *positions, *texcoords;
+	uint32_t *barycentrics = NULL;
+	uint16_t *indices;
+	EGLint *rects;
+	EGLint nrects;
+	GLint swizzle_a;
+	uint32_t r, c, i;
+	int k = 0;
+
+	positions = wl_array_add(&gr->position_stream,
+				 2 * n * sizeof *positions);
+	indices = wl_array_add(&gr->indices, nidx * sizeof *indices);
+	if (wireframe)
+		barycentrics = wl_array_add(&gr->barycentric_stream,
+					    n * sizeof *barycentrics);
+	if (!positions || !indices || (wireframe && !barycentrics))
+		goto out;
+	texcoords = positions + n;
+
+	for (i = 0; i < n; i++) {
+		struct weston_vector v = { .v.el = {
+			grid[i].u * pnode->surface->width,
+			grid[i].v * pnode->surface->height,
+			0.0f, 1.0f
+		} };
+
+		positions[i].x = grid[i].x;
+		positions[i].y = grid[i].y;
+		weston_matrix_transform(&sconf->surface_to_buffer, &v);
+		texcoords[i].x = v.v.el[0];
+		texcoords[i].y = v.v.el[1];
+	}
+
+	/* Each row of quads is one strip; neighbouring vertices of a strip's
+	 * triangles never share a corner value. */
+	for (r = 0; r + 1 < rows; r++) {
+		if (r > 0) {
+			indices[k] = indices[k - 1];
+			k++;
+			indices[k++] = r * cols;
+		}
+		for (c = 0; c < cols; c++) {
+			indices[k++] = r * cols + c;
+			indices[k++] = (r + 1) * cols + c;
+		}
+	}
+	assert(k == nidx);
+	if (wireframe) {
+		for (r = 0; r < rows; r++)
+			for (c = 0; c < cols; c++)
+				barycentrics[r * cols + c] =
+					corners[(c + 2 * r) % 3];
+	}
+
+	if (!pnode->draw_solid)
+		sconf->req.texcoord_input = SHADER_TEXCOORD_INPUT_ATTRIB;
+	sconf->projection = go->output_matrix;
+
+	set_blend_state(gr, pnode, !go->shader_blender);
+	if (!pnode->draw_solid && gb->shader_variant == SHADER_VARIANT_RGBA) {
+		swizzle_a = gb->texture_format[0].swizzles.a;
+		if (gb->parameters[0].swizzles.a != swizzle_a) {
+			gb->parameters[0].swizzles.a = swizzle_a;
+			gb->parameters[0].flags |= TEXTURE_SWIZZLES_DIRTY;
+		}
+	}
+
+	if (gr->debug_mode)
+		set_debug_mode(gr, sconf, barycentrics, false);
+
+	gl_log_paint_node(gr, "\t\tdrawing deformed paint node\n");
+	if (!gl_renderer_use_program(gr, pnode, sconf))
+		gl_renderer_send_shader_error(pnode);
+
+	glEnableVertexAttribArray(SHADER_ATTRIB_LOC_TEXCOORD);
+	glVertexAttribPointer(SHADER_ATTRIB_LOC_POSITION, 2, GL_FLOAT, GL_FALSE,
+			      0, positions);
+	glVertexAttribPointer(SHADER_ATTRIB_LOC_TEXCOORD, 2, GL_FLOAT, GL_FALSE,
+			      0, texcoords);
+
+	pixman_region_to_egl(pnode->output, repaint, go->border_status,
+			     &rects, &nrects);
+	glEnable(GL_SCISSOR_TEST);
+	for (i = 0; i < (uint32_t)nrects; i++) {
+		EGLint *rect = &rects[i * 4];
+
+		glScissor(rect[0], rect[1], rect[2], rect[3]);
+		glDrawElements(GL_TRIANGLE_STRIP, nidx, GL_UNSIGNED_SHORT,
+			       indices);
+	}
+	glDisable(GL_SCISSOR_TEST);
+	free(rects);
+
+	glDisableVertexAttribArray(SHADER_ATTRIB_LOC_TEXCOORD);
+	if (wireframe)
+		glDisableVertexAttribArray(SHADER_ATTRIB_LOC_BARYCENTRIC);
+
+out:
+	gr->position_stream.size = 0;
+	gr->indices.size = 0;
+	if (wireframe)
+		gr->barycentric_stream.size = 0;
+}
