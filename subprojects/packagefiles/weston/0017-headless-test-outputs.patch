+static int
+headless_head_create_full(struct weston_backend *base, const char *name,
+			  const uint8_t *edid, size_t edid_size, bool internal,
+			  const struct weston_headless_mode *modes, int n_modes)
+{
+	struct weston_head *found = NULL, *iter;
+	struct headless_head *head;
+	struct di_info *info = NULL;
+
+	if (n_modes < 1 || !modes)
+		return -1;
+	if (edid && edid_size > 0) {
+		info = di_info_parse_edid(edid, edid_size);
+		if (!info)
+			return -1;
+	}
+	if (headless_head_create(base, name) < 0) {
+		di_info_destroy(info);
+		return -1;
+	}
+	wl_list_for_each(iter, &to_headless_backend(base)->compositor->head_list,
+			 compositor_link) {
+		if (strcmp(iter->name, name) == 0 && to_headless_head(iter))
+			found = iter;
+	}
+	assert(found);
+	head = to_headless_head(found);
+	head->modes = xcalloc(n_modes, sizeof *head->modes);
+	memcpy(head->modes, modes, n_modes * sizeof *modes);
+	head->n_modes = n_modes;
+	if (info) {
+		const struct di_edid *parsed = di_info_get_edid(info);
+		const struct di_edid_screen_size *screen =
+			parsed ? di_edid_get_screen_size(parsed) : NULL;
+		char *make = di_info_get_make(info);
+		char *model = di_info_get_model(info);
+		char *serial = di_info_get_serial(info);
+
+		weston_head_set_monitor_strings(&head->base, make, model,
+						serial);
+		free(make);
+		free(model);
+		free(serial);
+		if (screen && screen->width_cm > 0)
+			weston_head_set_physical_size(&head->base,
+						      screen->width_cm * 10,
+						      screen->height_cm * 10);
+		head->base.display_info = info;
+	}
+	if (internal)
+		weston_head_set_internal(&head->base);
+	return 0;
+}
+
+static int
+headless_head_destroy_by_name(struct weston_backend *base, const char *name)
+{
+	struct weston_head *iter = NULL;
+
+	while ((iter = weston_compositor_iterate_heads(
+			to_headless_backend(base)->compositor, iter))) {
+		if (strcmp(iter->name, name) == 0 && to_headless_head(iter)) {
+			headless_head_destroy(iter);
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static const struct weston_headless_head_api head_api = {
+	headless_head_create_full,
+	headless_head_destroy_by_name,
+};
