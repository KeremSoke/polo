+static void
+headless_output_disable_renderer(struct headless_output *output)
+{
+	switch (output->backend->compositor->renderer->type) {
+	case WESTON_RENDERER_GL:
+		headless_output_disable_gl(output);
+		break;
+	case WESTON_RENDERER_VULKAN:
+		headless_output_disable_vulkan(output);
+		break;
+	case WESTON_RENDERER_PIXMAN:
+		headless_output_disable_pixman(output);
+		break;
+	default:
+		break;
+	}
+}
+
+static int
+headless_output_enable_renderer(struct headless_output *output)
+{
+	switch (output->backend->compositor->renderer->type) {
+	case WESTON_RENDERER_GL:
+		return headless_output_enable_gl(output);
+	case WESTON_RENDERER_VULKAN:
+		return headless_output_enable_vulkan(output);
+	case WESTON_RENDERER_PIXMAN:
+		return headless_output_enable_pixman(output);
+	default:
+		return 0;
+	}
+}
+
+/* Only for the modes of a head from weston_headless_head_api: the render
+ * target is made again at the new size. */
+static int
+headless_output_switch_mode(struct weston_output *base,
+			    struct weston_mode *mode)
+{
+	struct headless_output *output = to_headless_output(base);
+	struct weston_mode *previous;
+	bool known = false;
+
+	if (!output || !output->modes)
+		return -1;
+	for (int i = 0; i < output->n_modes; i++)
+		known |= mode == &output->modes[i];
+	if (!known)
+		return -1;
+	if (mode == base->current_mode)
+		return 0;
+
+	previous = base->current_mode;
+	if (base->enabled)
+		headless_output_disable_renderer(output);
+	previous->flags &= ~WL_OUTPUT_MODE_CURRENT;
+	mode->flags |= WL_OUTPUT_MODE_CURRENT;
+	base->current_mode = mode;
+	if (base->enabled && headless_output_enable_renderer(output) < 0) {
+		mode->flags &= ~WL_OUTPUT_MODE_CURRENT;
+		previous->flags |= WL_OUTPUT_MODE_CURRENT;
+		base->current_mode = previous;
+		headless_output_enable_renderer(output);
+		return -1;
+	}
+	return 0;
+}
