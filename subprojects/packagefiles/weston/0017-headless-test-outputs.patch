+#define WESTON_HEADLESS_HEAD_API_NAME "weston_headless_head_api_v1"
+
+/** A mode of a headless head created with weston_headless_head_api. */
+struct weston_headless_mode {
+	int32_t width;
+	int32_t height;
+	/** In mHz. */
+	uint32_t refresh;
+};
+
+/** Headless heads that look like real monitors, for testing compositors'
+ * output handling: identity from an EDID, an internal panel flag, several
+ * modes, and mode switching on the output made from the head.
+ */
+struct weston_headless_head_api {
+	/** Creates a connected head. The EDID gives its make, model, serial
+	 * and physical size, and may be NULL. The first of the n_modes modes
+	 * is preferred; output_set_size () picks the mode of that size, or
+	 * the preferred one, and switch_mode () moves between them.
+	 *
+	 * Returns 0 on success, -1 on failure.
+	 */
+	int (*create_head)(struct weston_backend *backend, const char *name,
+			   const uint8_t *edid, size_t edid_size,
+			   bool internal,
+			   const struct weston_headless_mode *modes,
+			   int n_modes);
+
+	/** Destroys the head called name, as a connector that goes away.
+	 *
+	 * Returns 0 on success, -1 if there is no such headless head.
+	 */
+	int (*destroy_head)(struct weston_backend *backend, const char *name);
+};
+
+static inline const struct weston_headless_head_api *
+weston_headless_head_get_api(struct weston_compositor *compositor)
+{
+	return (const struct weston_headless_head_api *)
+		weston_plugin_api_get(compositor,
+				      WESTON_HEADLESS_HEAD_API_NAME,
+				      sizeof(struct weston_headless_head_api));
+}
+
 #ifdef  __cplusplus
 }
 #endif
