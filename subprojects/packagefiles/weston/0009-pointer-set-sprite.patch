 static void
+pointer_set_cursor(struct wl_client *client, struct wl_resource *resource,
+		   uint32_t serial, struct wl_resource *surface_resource,
+		   int32_t x, int32_t y)
+{
+	struct weston_pointer *pointer = wl_resource_get_user_data(resource);
+	struct weston_surface *surface = NULL;
+
+	if (!pointer)
+		return;
+
+	if (surface_resource)
+		surface = wl_resource_get_user_data(surface_resource);
+
+	if (pointer->focus == NULL)
+		return;
+	/* A focused surface can lack a resource, such as shell.c's fullscreen
+	 * black_surface. */
+	if (pointer->focus->surface->resource == NULL)
+		return;
+	if (wl_resource_get_client(pointer->focus->surface->resource) != client)
+		return;
+	if (pointer->focus_serial - serial > UINT32_MAX / 2)
+		return;
+
+	weston_pointer_set_sprite(pointer, surface, x, y, resource);
+}
