root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C follows Weston: tabs, 80 columns.
[*.{c,h}]
indent_style = tab
indent_size = 8
max_line_length = 80

# Vala follows the GNOME/elementary style vala-lint checks.
[*.{vala,vapi}]
indent_style = space
indent_size = 4
max_line_length = 100

[{meson.build,meson_options.txt}]
indent_style = space
indent_size = 2

[*.{py,yml,yaml}]
indent_style = space
indent_size = 4

[*.yml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
