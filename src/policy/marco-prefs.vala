        /* Allowed nicks of enum keys, as "schema/key=nick,nick". */
        private const string[] ENUM_NICKS = {
            "general/focus-mode=click,sloppy,mouse",
            "general/focus-new-windows=smart,strict",
            "general/action-double-click-titlebar=toggle_shade,toggle_maximize,toggle_maximize_horizontally,toggle_maximize_vertically,minimize,none,lower,menu,last",
            "general/action-middle-click-titlebar=toggle_shade,toggle_maximize,toggle_maximize_horizontally,toggle_maximize_vertically,minimize,none,lower,menu,last",
            "general/action-right-click-titlebar=toggle_shade,toggle_maximize,toggle_maximize_horizontally,toggle_maximize_vertically,minimize,none,lower,menu,last",
            "general/wrap-style=no wrap,classic,toroidal",
            "general/visual-bell-type=invalid,fullscreen,frame_flash",
            "general/placement-mode=automatic,pointer,manual",
        };

        private GLib.HashTable<string, GLib.Variant> values;

        private MarcoPrefs () {
            values = new GLib.HashTable<string, GLib.Variant> (GLib.str_hash, GLib.str_equal);
            for (int i = 0; i < KEYS.length; i++) {
                try {
                    values.insert (KEYS[i], GLib.Variant.parse (new GLib.VariantType (TYPES[i]),
                                                                DEFAULTS[i]));
                } catch (GLib.VariantParseError e) {
                    GLib.error ("bad generated default for %s: %s", KEYS[i], e.message);
                }
            }
        }

        /* Marco's defaults. */
        public static MarcoPrefs defaults () {
            return new MarcoPrefs ();
        }

        /*
         * Defaults with some keys replaced. Each value must have the key's
         * type; enum keys take their nick as a string.
         */
        public static MarcoPrefs with_overrides (GLib.HashTable<string, GLib.Variant> overrides)
                throws PrefsError {
            var prefs = new MarcoPrefs ();
            foreach (unowned string key in overrides.get_keys ()) {
                prefs.set_checked (key, overrides[key]);
            }
            return prefs;
        }

        private void set_checked (string key, GLib.Variant value) throws PrefsError {
            unowned GLib.Variant? current = values.lookup (key);
            if (current == null) {
                throw new PrefsError.UNKNOWN_KEY ("no Marco key %s", key);
            }
            if (!value.get_type ().equal (current.get_type ())) {
                throw new PrefsError.WRONG_TYPE ("%s wants %s, got %s", key,
                                                 current.get_type_string (),
                                                 value.get_type_string ());
            }
            foreach (unowned string spec in ENUM_NICKS) {
                if (spec.has_prefix (key + "=")) {
                    var nicks = spec.substring (key.length + 1).split (",");
                    if (!(value.get_string () in nicks)) {
                        throw new PrefsError.BAD_VALUE ("%s has no value \"%s\"", key,
                                                        value.get_string ());
                    }
                }
            }
            values.insert (key, value);
        }

        /* The value of "schema/key"; null if there is no such key. */
        public GLib.Variant? get_value (string key) {
            return values.lookup (key);
        }

        public string get_keybinding (string schema, string name) {
            var value = values.lookup (schema + "/" + name);
            return value != null ? value.get_string () : "disabled";
        }

        /* Workspace names are 1-based in the schema. */
        public string workspace_name (int index) {
            var value = values.lookup ("workspace-names/name-%d".printf (index + 1));
            return value != null ? value.get_string () : "";
        }

        /* The part the C algorithms read. */
        public Marco.Prefs to_c () {
            return Marco.Prefs () {
                placement_mode = placement_mode,
                center_new_windows = center_new_windows,
                allow_tiling = allow_tiling,
                allow_top_tiling = allow_top_tiling,
                allow_tile_cycling = allow_tile_cycling,
                disable_workarounds = disable_workarounds
            };
        }

        private bool boolean (string key) {
            return values[key].get_boolean ();
        }

        private int integer (string key) {
            return values[key].get_int32 ();
        }

        private string text (string key) {
            return values[key].get_string ();
        }

        /* ---- org.mate.Marco.general ---- */
        public string mouse_button_modifier { owned get { return text ("general/mouse-button-modifier"); } }
        public bool resize_with_right_button { get { return boolean ("general/resize-with-right-button"); } }
        public bool show_tab_border { get { return boolean ("general/show-tab-border"); } }
        public string button_layout { owned get { return text ("general/button-layout"); } }
        public FocusMode focus_mode {
            get { return FocusMode.from_nick (text ("general/focus-mode")); }
        }
        public FocusNewWindows focus_new_windows {
            get { return FocusNewWindows.from_nick (text ("general/focus-new-windows")); }
        }
        public bool raise_on_click { get { return boolean ("general/raise-on-click"); } }
        public TitlebarAction action_double_click_titlebar {
            get { return TitlebarAction.from_nick (text ("general/action-double-click-titlebar")); }
        }
        public TitlebarAction action_middle_click_titlebar {
            get { return TitlebarAction.from_nick (text ("general/action-middle-click-titlebar")); }
        }
        public TitlebarAction action_right_click_titlebar {
            get { return TitlebarAction.from_nick (text ("general/action-right-click-titlebar")); }
        }
        public bool auto_raise { get { return boolean ("general/auto-raise"); } }
        public int auto_raise_delay { get { return integer ("general/auto-raise-delay"); } }
        public string theme { owned get { return text ("general/theme"); } }
        public bool titlebar_uses_system_font { get { return boolean ("general/titlebar-uses-system-font"); } }
        public string titlebar_font { owned get { return text ("general/titlebar-font"); } }
        public int num_workspaces { get { return integer ("general/num-workspaces"); } }
        public WrapStyle wrap_style {
            get { return WrapStyle.from_nick (text ("general/wrap-style")); }
        }
        public bool visual_bell { get { return boolean ("general/visual-bell"); } }
        public bool audible_bell { get { return boolean ("general/audible-bell"); } }
        public VisualBellType visual_bell_type {
            get { return VisualBellType.from_nick (text ("general/visual-bell-type")); }
        }
        public bool compositing_manager { get { return boolean ("general/compositing-manager"); } }
        public bool compositing_fast_alt_tab { get { return boolean ("general/compositing-fast-alt-tab"); } }
        public bool reduced_resources { get { return boolean ("general/reduced-resources"); } }
        public bool application_based { get { return boolean ("general/application-based"); } }
        public bool disable_workarounds { get { return boolean ("general/disable-workarounds"); } }
        public bool center_new_windows { get { return boolean ("general/center-new-windows"); } }
        public bool allow_tiling { get { return boolean ("general/allow-tiling"); } }
        public bool allow_top_tiling { get { return boolean ("general/allow-top-tiling"); } }
        public bool allow_tile_cycling { get { return boolean ("general/allow-tile-cycling"); } }
        public Marco.PlacementMode placement_mode {
            get {
                switch (text ("general/placement-mode")) {
                    case "automatic": return Marco.PlacementMode.AUTOMATIC;
                    case "pointer": return Marco.PlacementMode.POINTER;
                    case "manual": return Marco.PlacementMode.MANUAL;
                    default: return Marco.PlacementMode.AUTOMATIC;
                }
            }
        }
        public string show_desktop_skip_list { owned get { return text ("general/show-desktop-skip-list"); } }
        public int icon_size { get { return integer ("general/icon-size"); } }
        public int alt_tab_max_columns { get { return integer ("general/alt-tab-max-columns"); } }
        public bool alt_tab_expand_to_fit_title { get { return boolean ("general/alt-tab-expand-to-fit-title"); } }
        public bool alt_tab_raise_windows { get { return boolean ("general/alt-tab-raise-windows"); } }
    }
}
