namespace Polo {
    /* org.mate.Marco.FocusMode */
    public enum FocusMode {
        CLICK = 0,
        SLOPPY = 1,
        MOUSE = 2;

        public static FocusMode from_nick (string nick) {
            switch (nick) {
                case "click": return CLICK;
                case "sloppy": return SLOPPY;
                case "mouse": return MOUSE;
                default: return CLICK;
            }
        }
    }

    /* org.mate.Marco.FocusNewWindows */
    public enum FocusNewWindows {
        SMART = 0,
        STRICT = 1;

        public static FocusNewWindows from_nick (string nick) {
            switch (nick) {
                case "smart": return SMART;
                case "strict": return STRICT;
                default: return SMART;
            }
        }
    }

    /* org.mate.Marco.WrapStyle */
    public enum WrapStyle {
        NO_WRAP = 0,
        CLASSIC = 1,
        TOROIDAL = 2;

        public static WrapStyle from_nick (string nick) {
            switch (nick) {
                case "no wrap": return NO_WRAP;
                case "classic": return CLASSIC;
                case "toroidal": return TOROIDAL;
                default: return NO_WRAP;
            }
        }
    }

    /* org.mate.Marco.VisualBellType */
    public enum VisualBellType {
        INVALID = 0,
        FULLSCREEN = 1,
        FRAME_FLASH = 2;

        public static VisualBellType from_nick (string nick) {
            switch (nick) {
                case "invalid": return INVALID;
                case "fullscreen": return FULLSCREEN;
                case "frame_flash": return FRAME_FLASH;
                default: return INVALID;
            }
        }
    }

    /* org.mate.Marco.ActionTitlebar */
    public enum TitlebarAction {
        TOGGLE_SHADE = 0,
        TOGGLE_MAXIMIZE = 1,
        TOGGLE_MAXIMIZE_HORIZONTALLY = 2,
        TOGGLE_MAXIMIZE_VERTICALLY = 3,
        MINIMIZE = 4,
        NONE = 5,
        LOWER = 6,
        MENU = 7,
        LAST = 8;

        public static TitlebarAction from_nick (string nick) {
            switch (nick) {
                case "toggle_shade": return TOGGLE_SHADE;
                case "toggle_maximize": return TOGGLE_MAXIMIZE;
                case "toggle_maximize_horizontally": return TOGGLE_MAXIMIZE_HORIZONTALLY;
                case "toggle_maximize_vertically": return TOGGLE_MAXIMIZE_VERTICALLY;
                case "minimize": return MINIMIZE;
                case "none": return NONE;
                case "lower": return LOWER;
                case "menu": return MENU;
                case "last": return LAST;
                default: return TOGGLE_SHADE;
            }
        }
    }

