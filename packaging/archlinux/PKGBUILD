# Maintainer: Your Name <youremail@domain.com>
pkgname=polo
pkgver=1.0.2
pkgrel=2
epoch=0
pkgdesc="A Wayland compositor for the mate desktop environment"
arch=("x86_64")
url="https://github.com/KeremSoke/polo"
license=('GPL-3.0')
depends=('gtk3'  'mate-desktop' 'xorg-xwayland' 'vala' 'wayland-protocols' 'xdg-desktop-portal-gtk')
makedepends=('meson' 'grim' 'slurp' 'wl-clipboard' 'xdg-desktop-portal-wlr' )
optdepends=('grim: For screenshot key' 'slurp: For area select screenshot' 'wl-clipboard: sending screenshots to clipboard' 'xdg-desktop-wlr: For screensharing')
source=("https://github.com/KeremSoke/polo/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('15b13c91b89d49894cf186edf124df7be945785427e3e04969a5e37f4551b47b')

prepare() {
	cd "$pkgname-$pkgver"
}

build() {
	cd "$pkgname-$pkgver"
	meson setup build --buildtype=release --prefix=/usr
	meson compile -C build
}


package() {
	cd "$pkgname-$pkgver"
	DESTDIR="$pkgdir" meson install -C build
}
